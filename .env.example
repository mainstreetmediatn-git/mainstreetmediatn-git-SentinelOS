# Optional public URL; omit to use the same-origin BFF path /api/civitas.
VITE_CIVITAS_URL=
# Select the Civitas runtime through the server-side gateway.
VITE_CIVITAS_AGENT_RUNTIME=local

# Server-only BFF settings. Do not prefix these with VITE_.
CIVITAS_URL=http://127.0.0.1:8788
CIVITAS_API_TOKEN=
PORT=8789
